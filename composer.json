{
    "name": "rancoud/application",
    "description": "Application package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastien Rancoud",
            "email": "contact@rancoud.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Rancoud\\Application\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.4.27 || ^8.5.12 || ^8.6.0",
        "rancoud/environment": "3.0.4",
        "rancoud/router": "5.0.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.1",
        "phpunit/phpunit": "12.5.22",
        "rancoud/database": "7.0.4",
        "rancoud/session": "6.2.3"
    },
    "scripts": {
        "ci": [
            "@lint",
            "@test"
        ],
        "lint": [
            "php-cs-fixer fix -vvv"
        ],
        "test": [
            "phpunit --colors --display-all-issues --coverage-html ./coverage"
        ]
    }
}
